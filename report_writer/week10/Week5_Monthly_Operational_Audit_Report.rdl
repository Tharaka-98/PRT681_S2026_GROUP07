  <DataSources>
    <DataSource Name="Superstore_Sales_Performance_v1">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-aade526b-b369-4511-b852-bc7ac9d70a7e;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
