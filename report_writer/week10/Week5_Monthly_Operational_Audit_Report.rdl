  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Superstore_Sales_Performance_v1</DataSourceName>
        <CommandText>DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Superstore'[Order Date])),
			AND(
				'Superstore'[Order Date] &gt;= DATE(2024, 1, 1),
				'Superstore'[Order Date] &lt; DATE(2024, 2, 1)
			)
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP('Superstore'[Order Date], 'Superstore'[Region], 'Superstore'[Category]), "IsGrandTotalRowTotal"
			),
			__DS0FilterTable,
			"SumSales", CALCULATE(SUM('Superstore'[Sales])),
			"SumProfit", CALCULATE(SUM('Superstore'[Profit]))
		)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'Superstore'[Order Date],
	'Superstore'[Region],
	'Superstore'[Category]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Superstore'[Order Date])),
			AND(
				'Superstore'[Order Date] &gt;= DATE(2024, 1, 1),
				'Superstore'[Order Date] &lt; DATE(2024, 2, 1)
			)
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP('Superstore'[Order Date], 'Superstore'[Region], 'Superstore'[Category]), "IsGrandTotalRowTotal"
			),
			__DS0FilterTable,
			"SumSales", CALCULATE(SUM('Superstore'[Sales])),
			"SumProfit", CALCULATE(SUM('Superstore'[Profit]))
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'Superstore'[Order Date],
			1,
			'Superstore'[Region],
			1,
			'Superstore'[Category],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'Superstore'[Order Date],
	'Superstore'[Region],
	'Superstore'[Category]</wa:PreviewCommandText>
      </Query>
